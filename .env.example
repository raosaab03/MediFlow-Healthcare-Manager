# Optional: enables model-generated visit briefs; safe structured fallback works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: enables transactional booking and reminder email delivery.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=care@example.com

# Optional: enables doctor/patient Google Calendar event synchronization.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Protects scheduled notification-processing requests.
JOB_RUNNER_SECRET=replace-with-a-long-random-secret

# Optional sender details for booking confirmations and reminder processing.
CLINIC_CONTACT_EMAIL=care@example.com
